{
  "name": "system-assets",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "next build && npx @opennextjs/cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "pages:deploy": "npm run build:cf && npx wrangler deploy",
    "d1:init:local": "wrangler d1 execute system-assets-db --local --file=d1/schema.sql && wrangler d1 execute system-assets-db --local --file=d1/seed.sql",
    "d1:migrate:local": "wrangler d1 migrations apply system-assets-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply system-assets-db --remote",
    "d1:execute:local": "wrangler d1 execute system-assets-db --local --command"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.131.2"
  }
}
